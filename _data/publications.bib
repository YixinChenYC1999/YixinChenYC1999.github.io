@incollection{CHEN20259,
title = {Chapter 2 - CPS foundation and principles},
editor = {Wei Yu},
booktitle = {Edge Intelligence in Cyber-Physical Systems},
publisher = {Academic Press},
pages = {9-34},
year = {2025},
series = {Intelligent Data-Centric Systems},
isbn = {978-0-443-26572-3},
doi = {https://doi.org/10.1016/B978-0-44-326572-3.00008-5},
author = {Chen, Yixin and Qian, Cheng and Hussaini, Adamu and Yu, Wei},
keywords = {CPS, Foundation and principles, AI, Machine learning and Computing, Communication and control co-design},
abstract = {Cyber-physical systems (CPS) represent modern systems that blend computational and physical capabilities, enabling interaction with humans by leveraging advanced computer information and communication technology. The ability to engage with and enhance the physical world's capabilities using computation, communication, and control is essential for driving future technological advancements. The rapid changes in various application domains (e.g., smart energy grid, intelligent transportation, smart manufacturing, and smart homes, among others) have been facilitated by its development. Additionally, CPS uses a variety of computing and communication infrastructures to realize information interaction, monitoring, and control for physical subsystems, resulting in a highly integrated cyber and physical system. This chapter first presents a detailed overview of CPS by highlighting its concept, historical evolution, architecture, and critical components (computing, networking, and control). The chapter then presents integration with other emerging technologies, including edge computing, artificial intelligence (AI), and communication networks. Finally, challenges and future research directions are outlined to highlight the need for innovative solutions bridging the gap between theoretical models and real-world applications of CPS concerning modeling, simulation, testbed implementation, integrated component design, security and privacy, AI integration, and data-oriented service and application.}
}

@incollection{TIAN2025353,
title = {Chapter 14 - Secured edge intelligence in smart transportation CPS},
editor = {Wei Yu},
booktitle = {Edge Intelligence in Cyber-Physical Systems},
publisher = {Academic Press},
pages = {353-376},
year = {2025},
series = {Intelligent Data-Centric Systems},
isbn = {978-0-443-26572-3},
doi = {https://doi.org/10.1016/B978-0-44-326572-3.00023-1},
author = {Tian, Pu and Wang, Qianlong and Chen, Yixin and Yu, Wei},
keywords = {Edge AI, Smart transportation, Cybersecurity, IoT, Case study},
abstract = {This chapter explores smart transportation and relevant intricate security challenges with edge artificial intelligence (AI) integration. Smart transportation systems signify a major breakthrough in the development of urban transit, embodying a shift towards more advanced, efficient, and sustainable methods in travel and logistics management. At the same time, Edge AI significantly enhances smart transportation systems by enabling effective data processing and timely decision-making, improving efficiency, safety, and sustainability in urban transit systems. However, the implementation of Edge AI also poses security challenges stemming from its inherently distributed nature. The threats can compromise data integrity and model accuracy, undermining decision-making processes. This study conducts a comprehensive examination of current applications of Edge AI in smart transportation systems, with a particular emphasis on associated security concerns. Additionally, this chapter highlights the importance of establishing standardized protocols across various Internet of Things (IoT) devices and systems to enhance security measures. It further discusses the essential roles of consistent software updates, robust physical security, and resilient network infrastructure in upholding the integrity of these systems. The study emphasizes the necessity of a positive strategy to safeguard IoT and edge computing to defend against the continuously evolving landscape of cyber threats, especially in the context of distributed learning environments deployed in complicated scenarios.}
}